# Port des Node-Prozesses (API + in Production auch das ausgelieferte Frontend)
PORT=3000

# Nur setzen, wenn hinter einem Reverse Proxy/Load Balancer deployed
# (sorgt fuer korrektes req.protocol/req.ip, u.a. fuer og:url).
# TRUST_PROXY=1

# Nur setzen, wenn og:url (Social-Preview-Links) eine andere Basis-URL
# braucht als aus dem eingehenden Request ableitbar (z.B. CDN davor).
# PUBLIC_BASE_URL=https://real-ones.example.com

# Nur setzen, um CORS auf bestimmte Origins einzuschraenken (kommagetrennt).
# Ohne diese Variable ist CORS aktuell offen (siehe Bericht - vor
# oeffentlichem Launch pruefen/einschraenken).
# CORS_ORIGIN=https://real-ones.example.com
